#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define combo_timeout 50

// layer definitions
#define DEF 0
#define NUMSYM 1
#define NAV 2
#define FUN 3

/ {
  chosen {
    zmk,matrix_transform = &default_transform;
    //zmk,matrix_transform = &five_column_transform;
  };
};

&lt {
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_z {
            timeout-ms = <combo_timeout>;
            key-positions = <26 27>;
            bindings = <&kp Z>;
            layers = <DEF>;
        };
        combo_j {
            timeout-ms = <combo_timeout>;
            key-positions = <3 4>;
            bindings = <&kp J>;
            layers = <DEF>;
        };
        combo_q {
            timeout-ms = <combo_timeout>;
            key-positions = <7 8>;
            bindings = <&kp Q>;
            layers = <DEF>;
        };
        combo_lparens {
            timeout-ms = <combo_timeout>;
            key-positions = <15 16>;
            bindings = <&kp LEFT_PARENTHESIS>;
            layers = <DEF>;
        };
        combo_rparens {
            timeout-ms = <combo_timeout>;
            key-positions = <19 20>;
            bindings = <&kp RIGHT_PARENTHESIS>;
            layers = <DEF>;
        };
        combo_lbracket {
            timeout-ms = <combo_timeout>;
            key-positions = <14 15>;
            bindings = <&kp LEFT_BRACKET>;
            layers = <DEF>;
        };
        combo_rbracket {
            timeout-ms = <combo_timeout>;
            key-positions = <20 21>;
            bindings = <&kp RIGHT_BRACKET>;
            layers = <DEF>;
        };
        combo_lbrace {
            timeout-ms = <combo_timeout>;
            key-positions = <27 28>;
            bindings = <&kp LEFT_BRACE>;
            layers = <DEF>;
        };
        combo_rbrace {
            timeout-ms = <combo_timeout>;
            key-positions = <31 32>;
            bindings = <&kp RIGHT_BRACE>;
            layers = <DEF>;
        };
        combo_semicolon {
            timeout-ms = <combo_timeout>;
            key-positions = <32 33>;
            bindings = <&kp SEMICOLON>;
            layers = <DEF>;
        };
        combo_divide {
            timeout-ms = <combo_timeout>;
            key-positions = <7 8>;
            bindings = <&kp KP_DIVIDE>;
            layers = <NUMSYM>;
        };
        combo_asterisk {
            timeout-ms = <combo_timeout>;
            key-positions = <8 9>;
            bindings = <&kp ASTERISK>;
            layers = <NUMSYM>;
        };
        combo_capslock {
            timeout-ms = <combo_timeout>;
            key-positions = <16 19>;
            bindings = <&kp CAPS>;
            layers = <DEF>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &none   &none   &kp L   &kp H   &kp K     &kp Q                &kp J           &kp F       &kp O       &kp U     &none     &none
                &none   &kp V   &kp R   &kp N   &kp T     &kp W                &kp Y           &kp C       &kp A       &kp E     &kp SQT   &none
                &none   &kp S   &kp X   &kp M   &kp D     &kp B                &kp P           &kp G       &kp COMMA   &kp DOT   &kp I     &none
                                        &none   &sl FUN   &lt NUMSYM BSPC      &lt NAV SPACE   &sk LSHFT   &none
            >;
        };

        Numbers {
            bindings = <
                &none   &none       &kp AT      &kp HASH   &kp DLLR        &kp TILDE      &kp QMARK   &kp N7    &kp N8   &kp N9   &none       &none
                &none   &kp EXCL    &kp CARET   &kp AMPS   &kp UNDER       &kp GRAVE      &kp EQUAL   &kp N4    &kp N5   &kp N6   &kp MINUS   &none
                &none   &kp PRCNT   &kp PIPE    &kp BSLH   &kp LA(LS(2))   &none          &none       &kp N1    &kp N2   &kp N3   &kp PLUS    &none
                                                &none      &none           &none          &kp N0      &kp DOT   &none
            >;
        };

        Navigation {
            bindings = <
                &none   &none       &kp HOME    &kp UP      &kp END     &none          &none   &none       &none     &none   &none   &none
                &none   &kp PG_UP   &kp LEFT    &kp DOWN    &kp RIGHT   &kp LG(Z)      &none   &kp ENTER   &kp ESC   &none   &none   &none
                &none   &kp PG_DN   &kp LG(X)   &kp LG(C)   &kp LG(V)   &none          &none   &none       &none     &none   &none   &none
                                                &none       &kp TAB     &kp DEL        &none   &none       &none
            >;
        };

        Function {
            bindings = <
                &none   &none    &kp F6      &kp F7      &kp F8      &kp F9         &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &none        &none  
                &none   &kp F5   &kp F2      &kp F3      &kp F4      &kp LG(Z)      &none          &sk LCTRL      &sk LSHFT      &sk LALT       &bt BT_CLR   &none
                &none   &kp F1   &kp LG(X)   &kp LG(C)   &kp LG(V)   &none          &none          &none          &none          &none          &sk LGUI     &none
                                             &none       &none       &none          &none          &none          &none
            >;    
        };
    };
};
