#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define combo_timeout 50

// layer definitions
#define MAIN 0
#define NUMSYM 1
#define NAV 2
#define FUN 3

/ {
  chosen {
    zmk,matrix_transform = &default_transform;
    //zmk,matrix_transform = &five_column_transform;
  };
};

&lt {
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        lsk: lazy_sticky_key {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <3000>;
            quick-release;
            ignore-modifiers;
            lazy;
        };

        sm: sticky_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&lsk>;
            flavor = "balanced";
            hold-while-undecided;
        };
    };

    macros {
        slfun: sl_fun {
            label = "SL_NAV";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_tap &kp K_CANCEL>
                , <&macro_press &sl FUN>
                , <&macro_pause_for_release>
                , <&macro_release &sl FUN>
                ;
        };
    };
    combos {
        compatible = "zmk,combos";
        combo_z {
            timeout-ms = <combo_timeout>;
            key-positions = <26 27>;
            bindings = <&kp Z>;
            layers = <MAIN>;
        };
        combo_j {
            timeout-ms = <combo_timeout>;
            key-positions = <3 4>;
            bindings = <&kp J>;
            layers = <MAIN>;
        };
        combo_q {
            timeout-ms = <combo_timeout>;
            key-positions = <7 8>;
            bindings = <&kp Q>;
            layers = <MAIN>;
        };
        combo_lparens {
            timeout-ms = <combo_timeout>;
            key-positions = <15 16>;
            bindings = <&kp LEFT_PARENTHESIS>;
            layers = <MAIN>;
        };
        combo_rparens {
            timeout-ms = <combo_timeout>;
            key-positions = <19 20>;
            bindings = <&kp RIGHT_PARENTHESIS>;
            layers = <MAIN>;
        };
        combo_lbracket {
            timeout-ms = <combo_timeout>;
            key-positions = <14 15>;
            bindings = <&kp LEFT_BRACKET>;
            layers = <MAIN>;
        };
        combo_rbracket {
            timeout-ms = <combo_timeout>;
            key-positions = <20 21>;
            bindings = <&kp RIGHT_BRACKET>;
            layers = <MAIN>;
        };
        combo_lbrace {
            timeout-ms = <combo_timeout>;
            key-positions = <27 28>;
            bindings = <&kp LEFT_BRACE>;
            layers = <MAIN>;
        };
        combo_rbrace {
            timeout-ms = <combo_timeout>;
            key-positions = <31 32>;
            bindings = <&kp RIGHT_BRACE>;
            layers = <MAIN>;
        };
        combo_semicolon {
            timeout-ms = <combo_timeout>;
            key-positions = <32 33>;
            bindings = <&kp SEMICOLON>;
            layers = <MAIN>;
        };
        combo_divide {
            timeout-ms = <combo_timeout>;
            key-positions = <7 8>;
            bindings = <&kp KP_DIVIDE>;
            layers = <NUMSYM>;
        };
        combo_asterisk {
            timeout-ms = <combo_timeout>;
            key-positions = <8 9>;
            bindings = <&kp ASTERISK>;
            layers = <NUMSYM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &none  &none  &kp L  &kp H  &kp K   &kp Q                     &kp J          &kp F           &kp O      &kp U       &kp COMMA  &none
                &none  &kp V  &kp R  &kp N  &kp T   &kp W                     &kp Y          &kp C           &kp A      &kp E       &kp SQT    &none
                &none  &kp S  &kp X  &kp M  &kp D   &kp B                     &kp P          &kp G           &kp COMMA  &kp PERIOD  &kp I      &none
                                     &none  &slfun  &lt NUMSYM BACKSPACE      &lt NAV SPACE  &sk LEFT_SHIFT  &none
            >;
        };

        Numbers {
            bindings = <
                &none  &none      &kp AT     &kp HASH  &kp DLLR       &kp TILDE      &kp QUESTION     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none      &none
                &none  &kp EXCL   &kp CARET  &kp AMPS  &kp UNDER      &kp GRAVE      &kp EQUAL        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS  &none
                &none  &kp PRCNT  &kp PIPE   &kp BSLH  &kp LA(LS(2))  &none          &none            &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PLUS   &none
                                                   &none     &none           &none          &kp KP_NUMBER_0  &kp DOT &none
            >;
        };

        Navigation {
            bindings = <
                &none  &none          &kp HOME        &kp UP_ARROW  &kp END          &none           &none  &none      &none       &none         &none         &none
                &none  &kp PAGE_UP    &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &kp LG(Z)       &none  &kp ENTER  &kp ESCAPE  &kp LEFT_ALT  &none         &none
                &none  &kp PAGE_DOWN  &kp LG(X)       &kp LG(C)     &kp LG(V)        &none           &none  &none      &none       &none         &kp LEFT_GUI  &none
                                                      &none         &kp TAB          &kp DELETE      &none  &none      &none
            >;
        };

        Function {
            bindings = <
                &none  &none   &kp F6     &kp F7     &kp F8     &kp F9                               &bt BT_SEL 0  &bt BT_SEL 1      &bt BT_SEL 2    &bt BT_SEL 3  &none         &none  
                &none  &kp F5  &kp F2     &kp F3     &kp F4     &kp LG(Z)                            &none         &sm LEFT_CONTROL  &sm LEFT_SHIFT  &sm LEFT_ALT  &bt BT_CLR    &none
                &none  &kp F1  &kp LG(X)  &kp LG(C)  &kp LG(V)  &none                                &none         &none             &none           &none         &sm LEFT_GUI  &none
                                          &none      &none      &none                                &none         &none             &none
            >;    
        };
    };
};
